msgid "Settings"
msgstr "Settings"

#: extensions/scylla-base/src/features/instance-settings/presentation/messages/instance-settings.messages.ts:5
msgid "Settings of this Scylla server. Only instance admins see this page."
msgstr "Settings of this Scylla server. Only instance admins see this page."

#: extensions/scylla-base/src/features/instance-settings/presentation/messages/instance-settings.messages.ts:16
msgid "Turn off"
msgstr "Turn off"

#: extensions/scylla-base/src/features/instance-settings/presentation/messages/instance-settings.messages.ts:9
msgid "Turn off personal tokens?"
msgstr "Turn off personal tokens?"

#: extensions/scylla-base/src/features/instance-settings/presentation/messages/instance-settings.messages.ts:8
msgid "Turning it off asks for a confirmation and shows how many tokens stop. Workspace admins can also turn personal tokens off in their own workspace."
msgstr "Turning it off asks for a confirmation and shows how many tokens stop. Workspace admins can also turn personal tokens off in their own workspace."

#: extensions/scylla-base/src/features/instance-settings/presentation/messages/instance-settings.messages.ts:7
msgid "Users can make tokens that act as themselves. When off, every personal token stops working at once. App tokens are not affected."
msgstr "Users can make tokens that act as themselves. When off, every personal token stops working at once. App tokens are not affected."
