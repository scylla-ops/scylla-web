msgid "Members"
msgstr "Membres"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:18
msgid "No role"
msgstr "Aucun rôle"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:20
msgid "No role can be granted here."
msgstr "Aucun rôle ne peut être attribué ici."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:44
msgid "Nobody belongs to this workspace yet."
msgstr "Personne n'appartient encore à cet espace de travail."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:58
msgid "Nobody has access to this project yet."
msgstr "Personne n'a encore accès à ce projet."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:26
msgid "Nobody is listed here yet."
msgstr "Personne n'est listé ici pour l'instant."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:43
msgid "Only a system admin can browse the users."
msgstr "Seul un administrateur système peut parcourir les utilisateurs."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:64
msgid "Only members of the workspace can be added: a project role granted to anyone else is refused."
msgstr "Seuls les membres de l'espace de travail peuvent être ajoutés : un rôle de projet accordé à quelqu'un d'autre est refusé."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:5
#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:11
msgid "Owners"
msgstr "Propriétaires"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:49
msgid "Pick someone and the roles they should hold in this workspace."
msgstr "Choisissez une personne et les rôles qu'elle doit détenir dans cet espace de travail."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:24
msgid "Platform roles"
msgstr "Rôles de la plateforme"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:67
msgid "Project roles to grant"
msgstr "Rôles de projet à attribuer"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:45
msgid "Reached via a project"
msgstr "Atteint via un projet"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:8
msgid "Remove {name} from the owners"
msgstr "Retirer {name} des propriétaires"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:53
msgid "Remove {username} from “{workspace}”?"
msgstr "Retirer {username} de « {workspace} » ?"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:68
msgid "Remove {username} from this project?"
msgstr "Retirer {username} de ce projet ?"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:60
msgid "Remove from the project"
msgstr "Retirer du projet"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:47
msgid "Remove from the workspace"
msgstr "Retirer de l'espace de travail"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:28
msgid "Revoke {name}"
msgstr "Révoquer {name}"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:33
msgid "Role granted"
msgstr "Rôle accordé"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:34
msgid "Role revoked"
msgstr "Rôle révoqué"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:61
msgid "Roles badged “Workspace” are inherited from the workspace and are managed there."
msgstr "Les rôles marqués « Espace de travail » sont hérités de l'espace de travail et se gèrent là-bas."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:51
msgid "Roles to grant"
msgstr "Rôles à attribuer"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:25
msgid "Select a user"
msgstr "Sélectionner un utilisateur"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:39
msgid "Select a workspace to see its members."
msgstr "Sélectionnez un espace de travail pour voir ses membres."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:6
msgid "The owners can delete the workspace and change its owners. No role gives that. The last owner stays."
msgstr "Les propriétaires peuvent supprimer l'espace de travail et changer ses propriétaires. Aucun rôle ne donne ce droit. Le dernier propriétaire reste."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:10
msgid "Workspace"
msgstr "Espace de travail"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:62
msgid "Workspace administrators also reach this project. Their roles are managed at the workspace level and are not listed here."
msgstr "Les administrateurs de l'espace de travail ont aussi accès à ce projet. Leurs rôles sont gérés au niveau de l'espace de travail et ne sont pas listés ici."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:17
msgid "You"
msgstr "Vous"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:66
msgid "You can't browse the workspace's members"
msgstr "Vous ne pouvez pas parcourir les membres de l'espace de travail"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:57
msgid "You don't have permission to add members to this project."
msgstr "Vous n'avez pas la permission d'ajouter des membres à ce projet."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:42
msgid "You don't have permission to admit members here."
msgstr "Vous n'avez pas la permission d'admettre des membres ici."
