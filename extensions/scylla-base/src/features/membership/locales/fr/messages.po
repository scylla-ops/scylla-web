#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:36
msgid "{username} removed: {revoked} grant(s) revoked"
msgstr "{username} retiré : {revoked} attribution(s) révoquée(s)"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:31
msgid "{value, plural, =0 {No role} one {# role} other {# roles}}"
msgstr "{value, plural, =0 {Aucun rôle} one {# rôle} other {# rôles}}"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:23
msgid "{workspace} roles"
msgstr "Rôles de l'espace de travail {workspace}"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:7
msgid "+ owner"
msgstr "+ propriétaire"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:22
msgid "+ role"
msgstr "+ rôle"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:16
msgid "Add"
msgstr "Ajouter"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:14
msgid "Add a member"
msgstr "Ajouter un membre"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:48
msgid "Add a member to “{name}”"
msgstr "Ajouter un membre à « {name} »"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:63
msgid "Add a member to this project"
msgstr "Ajouter un membre à ce projet"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:41
msgid "Belonging to “{name}” means holding a role in it. Granting someone their first role admits them; revoking every role they hold here, and on its projects, removes them."
msgstr "Appartenir à « {name} », c'est y détenir un rôle. Accorder son premier rôle à quelqu'un l'y admet ; révoquer tous les rôles qu'il détient ici, et sur ses projets, l'en retire."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:15
msgid "Cancel"
msgstr "Annuler"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:65
msgid "Every member of the workspace is already here"
msgstr "Tous les membres de l'espace de travail sont déjà présents"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:69
msgid "Every role they hold on this project will be revoked. Roles inherited from the workspace are untouched: they are managed at the workspace level."
msgstr "Tous les rôles qu'il détient sur ce projet seront révoqués. Les rôles hérités de l'espace de travail ne sont pas touchés : ils sont gérés au niveau de l'espace de travail."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:54
msgid "Every role they hold on this workspace and on its projects will be revoked. They will lose access immediately."
msgstr "Tous les rôles qu'il détient sur cet espace de travail et sur ses projets seront révoqués. Il perdra l'accès immédiatement."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:50
msgid "Everyone is already a member"
msgstr "Tout le monde est déjà membre"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:56
msgid "Everyone with access to this project, whether granted here or through a role on the workspace. Only project roles can be changed from this page."
msgstr "Toutes les personnes ayant accès à ce projet, qu'il soit accordé ici ou via un rôle sur l'espace de travail. Seuls les rôles de projet peuvent être modifiés depuis cette page."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:21
msgid "Held"
msgstr "Détenu"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:9
msgid "Invite by email"
msgstr "Inviter par e-mail"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:19
msgid "Loading…"
msgstr "Chargement…"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:27
