msgstr "Géré au niveau de l'espace de travail."

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:59
msgid "Managed by a project administrator"
msgstr "Géré par un administrateur du projet"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:46
msgid "Managed by a workspace administrator"
msgstr "Géré par un administrateur de l'espace de travail"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:12
msgid "Member"
msgstr "Membre"

#: extensions/scylla-base/src/features/membership/presentation/messages/membership.messages.ts:37
