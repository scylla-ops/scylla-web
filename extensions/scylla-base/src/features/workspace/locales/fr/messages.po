msgstr "Enregistrer"

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace.messages.ts:16
msgid "Saving..."
msgstr "Enregistrement..."

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:4
msgid "Security"
msgstr "Sécurité"

#: extensions/scylla-base/src/features/workspace/workspace.module.ts:27
#: extensions/scylla-base/src/features/workspace/workspace.module.ts:34
msgid "Settings"
msgstr "Paramètres"

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:6
msgid "Settings of the workspace {workspace}. Only admins of {workspace} see this page."
msgstr "Les paramètres de l'espace de travail {workspace}. Seuls ses admins voient cette page."

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:15
msgid "Turn off"
msgstr "Désactiver"

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:12
msgid "Turn off personal tokens in {workspace}?"
msgstr "Désactiver les tokens personnels dans {workspace} ?"

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:10
msgid "Turning it off asks for a confirmation. The instance switch comes first: when an instance admin turns personal tokens off on the server, this switch is off and locked."
msgstr "La désactivation demande une confirmation. Le réglage de l'instance passe en premier : quand un admin de l'instance désactive les tokens personnels sur le serveur, ce réglage est désactivé et verrouillé."

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace.messages.ts:14
msgid "Update the name and the address of the workspace."
msgstr "Mettez à jour le nom et l'adresse de l'espace de travail."

