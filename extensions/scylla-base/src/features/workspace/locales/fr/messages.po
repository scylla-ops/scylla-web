#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:14
msgid "{workspace} refuses them at once: scripts that use them get \"403 Permission denied\" here. They still work in other workspaces. App tokens and CI identities do not change. You can turn them on again at any time."
msgstr "{workspace} les refuse tout de suite : les scripts qui les utilisent reçoivent « 403 Permission denied » ici. Ils marchent encore dans les autres espaces de travail. Les tokens des apps et les identités CI ne changent pas. Vous pouvez les réactiver à tout moment."

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace.messages.ts:18
#: extensions/scylla-base/src/features/workspace/presentation/presenters/workspace-form.presenter.ts:14
msgid "Address"
msgstr "Adresse"

#: extensions/scylla-base/src/features/workspace/presentation/messages/workspace-settings.messages.ts:11
msgid "An instance admin turned personal tokens off on this server, so this switch is off and locked."
msgstr "Un admin de l'instance a désactivé les tokens personnels sur ce serveur : ce réglage est donc désactivé et verrouillé."

