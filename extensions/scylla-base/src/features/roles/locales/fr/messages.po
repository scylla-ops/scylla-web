#: extensions/scylla-base/src/features/roles/presentation/messages/roles.messages.ts:12
msgid "The roles that you can give in {workspace}. Roles of {again} are only seen there. Roles from the instance are the same in every workspace."
msgstr "Les rôles que vous pouvez donner dans {workspace}. Les rôles de {again} ne se voient que là. Les rôles de l'instance sont les mêmes dans chaque espace de travail."

