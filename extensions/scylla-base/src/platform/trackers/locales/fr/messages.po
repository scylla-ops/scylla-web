#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:79
msgid "Holds the id of the user who is signed in."
msgstr "Contient l'identifiant de l'utilisateur connecté."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:43
msgid "Holds the identity of a provider while you link it to your account."
msgstr "Contient l'identité d'un fournisseur pendant que vous la liez à votre compte."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:97
msgid "Keeps the copy of your interface settings the same as the copy of the server."
msgstr "Garde la copie de vos réglages d'interface identique à la copie du serveur."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:70
msgid "Keeps the language that you chose. With no choice, the app uses the language of the browser."
msgstr "Garde la langue que vous avez choisie. Sans choix, l'application prend la langue du navigateur."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:169
msgid "Keeps the page to go back to after the install of the GitHub App."
msgstr "Garde la page où revenir après l'installation de l'application GitHub."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:115
msgid "Keeps the release notes that you saw."
msgstr "Garde les notes de version que vous avez vues."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:124
msgid "Keeps the style of the nodes in the pipeline editor."
msgstr "Garde le style des nœuds dans l'éditeur de pipeline."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:160
msgid "Keeps the time of your last visit to the dashboards."
msgstr "Garde l'heure de votre dernière visite des tableaux de bord."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:133
msgid "Keeps the width of the second sidebar."
msgstr "Garde la largeur de la seconde barre latérale."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:88
msgid "Keeps the workspace and the project that you have open."
msgstr "Garde l'espace de travail et le projet que vous avez ouverts."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:25
msgid "Keeps you signed in: it holds the token of the session of this browser."
msgstr "Vous garde connecté : il contient le jeton de la session de ce navigateur."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:52
msgid "Keeps your choice for the trackers that need your consent, so the app does not ask again. The app sets it only when it has such a tracker."
msgstr "Garde votre choix pour les traceurs qui demandent votre consentement, pour que l'application ne vous le redemande pas. L'application ne le crée que si elle a un tel traceur."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:151
msgid "Keeps your default dashboard."
msgstr "Garde votre tableau de bord par défaut."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:142
msgid "Keeps your last entries in the command bar."
msgstr "Garde vos dernières entrées dans la barre de commandes."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:106
msgid "Keeps your progress in the guided tour."
msgstr "Garde votre progression dans la visite guidée."

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:61
msgid "Keeps your theme: light, dark or the theme of the system."
msgstr "Garde votre thème : clair, sombre ou celui du système."

#: extensions/scylla-base/src/platform/trackers/presentation/messages/trackers.messages.ts:35
msgid "Let you talk to the support team from the app."
msgstr "Vous permettent de parler à l'équipe de support depuis l'application."

#: extensions/scylla-base/src/platform/trackers/presentation/messages/trackers.messages.ts:19
msgid "Lifetime: {lifetime}"
msgstr "Durée de vie : {lifetime}"

#: extensions/scylla-base/src/platform/trackers/presentation/ui/trackers.registry.ts:34
msgid "Links a sign-in with GitHub, GitLab or OIDC to this browser, against a forged sign-in."
msgstr "Lie une connexion avec GitHub, GitLab ou OIDC à ce navigateur, contre une connexion falsifiée."

