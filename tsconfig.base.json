{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Relative to this file, so a host workspace that extends it resolves them too. */
    "paths": {
      "@base/*": ["./extensions/scylla-base/src/*"],
      "@platform/*": ["./extensions/scylla-base/src/platform/*"],
      "@shared/*": ["./extensions/scylla-base/src/shared/*"],
      "@test/*": ["./test/*"]
    }
  }
}
