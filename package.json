{
  "name": "scylla",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "config": {
    "protocVersion": "35.1"
  },
  "scripts": {
    "dev": "pnpm run prebuild && vite",
    "build": "pnpm run prebuild && pnpm run typecheck && vite build",
    "typecheck": "tsc -b && svelte-check --tsconfig ./tsconfig.app.json --threshold error",
    "prebuild": "pnpm run gen-proto && (pnpm run extract || true) && pnpm run compile",
    "gen-proto": "node scripts/gen-proto.mjs",
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:file": "vitest run --fsModuleCache",
    "test:name": "vitest run --fsModuleCache -t",
    "test:dir": "vitest run --fsModuleCache --dir",
    "test:changed": "vitest run --fsModuleCache --changed",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "coverage": "vitest run --coverage",
    "depcruise": "depcruise apps packages sdks extensions test --config .dependency-cruiser.cjs",
    "depcruise:cycles": "depcruise apps packages sdks extensions test --config .dependency-cruiser.cjs --output-type json | node scripts/check-module-cycles.mjs",
    "i18n:collisions": "node scripts/check-catalog-collisions.mjs",
    "check:authors": "node scripts/check-commit-authors.mjs",
    "tokens:export": "node scripts/export-tokens.mjs",
    "tokens:check": "node scripts/export-tokens.mjs --check",
    "depcruise:graph": "depcruise apps packages sdks extensions --config .dependency-cruiser.cjs --output-type archi | dot -T svg > dependency-graph.svg",
    "preview": "vite preview",
    "ui:catalog": "pnpm run compile && pnpm --filter @scylla/catalog dev",
    "ui:catalog:build": "pnpm run compile && pnpm --filter @scylla/catalog check && pnpm --filter @scylla/catalog build"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lingui/core": "^6.12.0",
    "@lucide/svelte": "^1.70.0",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@tanstack/query-core": "5.107.1",
    "@tanstack/svelte-query": "^6.4.1",
    "@tanstack/svelte-table": "^9.3.1",
    "@tanstack/table-core": "9.3.1",
    "@xyflow/svelte": "^1.7.1",
    "bits-ui": "^2.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "paneforge": "^1.0.2",
    "svelte": "^5.57.3",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "1.65.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@scylla/base": "workspace:*",
    "@scylla/core": "workspace:*",
    "@scylla/core-sdk": "workspace:*",
    "@scylla/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
