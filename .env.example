# Only needed for `pnpm dev`, where Vite serves the UI from :5173 and the API
# lives on another origin. A deployed instance serves the bundle from the
# control plane itself, so this stays UNSET and the client uses relative URLs —
# which is what makes one image usable across deployments.
VITE_API_URL=http://localhost:8080

# Umami analytics. Leave both UNSET here on purpose: tracking only runs in a
# production build (`import.meta.env.PROD`), so local dev never shows up in the
# dashboard. Set the real values wherever the production image is actually
# built (CI secrets, a Dockerfile env) — not in a file committed to this repo.
VITE_UMAMI_SRC=https://umami.scylla-ops.com/script.js
VITE_UMAMI_WEBSITE_ID=<UID from the unami dashboard>
